# AWS credentials are read from the standard credential chain; set these only for local dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
# Optional custom endpoint (e.g. MinIO / LocalStack)
DATAMINE_S3_ENDPOINT=

# Pipeline locations (local paths or s3:// URIs)
DATAMINE_RAW_URI=./data/raw
DATAMINE_OUTPUT_URI=./data/curated

# Embeddings: "hashing" (no deps) or "clip" (requires the [clip] extra)
DATAMINE_EMBEDDER=hashing
DATAMINE_CLIP_MODEL=ViT-B-32
DATAMINE_CLIP_PRETRAINED=laion2b_s34b_b79k

# Spark
DATAMINE_SPARK_MASTER=local[*]
